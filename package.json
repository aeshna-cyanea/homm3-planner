{
  "name": "hota-production-planner",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "vite --host 127.0.0.1 --port 8000",
    "preview": "vite preview --host 127.0.0.1 --port 8001",
    "serve:test": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "pretest:visual": "npm run build",
    "test:visual": "playwright test",
    "pretest:visual:update": "npm run build",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.13"
  },
  "dependencies": {
    "@tarekraafat/autocomplete.js": "^10.2.10",
    "solid-js": "^1.9.14"
  }
}
